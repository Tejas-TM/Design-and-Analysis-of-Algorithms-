#include <stdio.h>
#include <string.h>

int main() {
    int m, n, r, p;
    int i, j, k;  // <-- declare here

    scanf("%d %d", &m, &n);

    int A[m][n];
    for (i = 0; i < m; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &A[i][j]);

    scanf("%d %d", &r, &p);

    if (n != r) {
        printf("Invalid input\n");
    } else {
        int B[r][p];
        for (i = 0; i < r; i++)
            for (j = 0; j < p; j++)
                scanf(" %d", &B[i] [j]);

        int C[m][p];
        memset(C, 0, sizeof(C));

        for (i = 0; i < m; i++)
            for (j = 0; j < p; j++)
                for (k = 0; k < n; k++)
                    C[i][j] += A[i][k] * B[k][j];

        for (i = 0; i < m; i++) {
            for (j = 0; j < p; j++) {
                if (j > 0) printf(" ");
                printf("%d", C[i][j]);
            }
            printf(" \n");
        }
    }
    return 0;
}   
