#include <stdio.h>
#include <stdlib.h>

#define INF 99999999

struct Edge {
    int u, v, w;
};

// Function to print the path recursively from source to destination
void printPath(int parent[], int j, int src) {
    if (j == src) {
        printf("%d", src);
        return;
    }
    printPath(parent, parent[j], src);
    printf("->%d", j);
}

int main() {
    int V, E, src;
    
    // Read vertices and edges
    if (scanf("%d", &V) != 1) return 0;
    if (scanf("%d", &E) != 1) return 0;

    struct Edge* edges = (struct Edge*)malloc(E * sizeof(struct Edge));
    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);
    }

    // Read the source vertex
    if (scanf("%d", &src) != 1) {
        free(edges);
        return 0;
    }

    // Allocate memory for distances and predecessors (1-based index support)
    int* dist = (int*)malloc((V + 1) * sizeof(int));
    int* parent = (int*)malloc((V + 1) * sizeof(int));

    // Step 1: Initialize distances from source to all other vertices as INF
    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }
    dist[src] = 0;

    // Step 2: Relax all edges |V| - 1 times
    for (int i = 1; i <= V - 1; i++) {
        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;
            if (dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
            }
        }
    }

    // Step 3: Check for negative-weight cycles
    int hasNegativeCycle = 0;
    for (int j = 0; j < E; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        int w = edges[j].w;
        if (dist[u] != INF && dist[u] + w < dist[v]) {
            hasNegativeCycle = 1;
            break;
        }
    }

    // Step 4: Generate Output
    if (hasNegativeCycle) {
        printf("Negative cycle detected\n");
    } else {
        for (int i = 1; i <= V; i++) {
            if (i == src) continue;

            if (dist[i] == INF) {
                printf("%d INF None\n", i);
            } else {
                printf("%d %d ", i, dist[i]);
                printPath(parent, i, src);
                printf("\n");
            }
        }
    }

    // Clean up allocated memory
    free(edges);
    free(dist);
    free(parent);

    return 0;
}
